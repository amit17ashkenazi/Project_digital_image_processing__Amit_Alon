# Ignore all images of specific formats everywhere
*.png
*.jpg
*.jpeg

# ...except the README's own result images/graphs -- these must be
# shareable via git so teammates/graders can see them without re-running
# anything.
!outputs/**/*.png
!docs/readme_assets/**/*.png

# Ignore archive and compressed files
*.zip
*.tar
*.gz
*.rar

# Ignore environment files
env

# Duplicate fine-tuning training artifacts (already summarized into
# docs/readme_assets/finetuning/) -- large (33MB) and not needed in git.
Amit_project/runs/

# Office lock/temp files (created while a doc is open in Word/PowerPoint)
~$*